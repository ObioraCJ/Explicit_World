NODE_ENV=development
PORT=5000

MONGO_URI=mongodb://127.0.0.1:27017/fashion_ecommerce

JWT_SECRET=change_this_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=


# Email (password reset, order notifications) - use Mailtrap.io for free dev testing
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@explicitworld.com

# Bank transfer payment option - shown to customers who choose this method at checkout
BANK_NAME=
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=

CLIENT_URL=http://localhost:5173